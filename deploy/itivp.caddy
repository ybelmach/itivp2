# Блок сайта для общего Caddy на SSH-ноде (/srv/infrastructure/caddy/conf.d/itivp.caddy).
# itivp.ybelmach.ru — A-запись на 167.86.121.175 (DNS в Selectel); sslip.io — запасное имя без DNS-записи.
# Сертификаты Let's Encrypt Caddy получает и продлевает сам.
itivp.ybelmach.ru, itivp.167.86.121.175.sslip.io {
	encode zstd gzip
	reverse_proxy itivp-web:80
}
