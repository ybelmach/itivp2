# Домен, указывающий на IP виртуальной машины (для HTTPS). Без домена — ":80" (только HTTP)
DOMAIN=study.example.com

POSTGRES_PASSWORD=change-me
# Внешняя БД (Neon) вместо локального контейнера — раскомментировать:
# DATABASE_URL=postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true

JWT_SECRET=change-me
CORS_ORIGINS=https://study.example.com
LOG_LEVEL=http

SENTRY_DSN=
VITE_SENTRY_DSN=
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Если Docker Hub недоступен — образы из зеркала
# NODE_IMAGE=mirror.gcr.io/library/node:22-alpine
# POSTGRES_IMAGE=mirror.gcr.io/library/postgres:17-alpine
# CADDY_IMAGE=mirror.gcr.io/library/caddy:2-alpine
