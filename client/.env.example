# Адрес API. По умолчанию /api — его проксирует Vite (локально), Vercel или nginx (в продакшене).
# Абсолютный URL указывать, только если фронтенд и API на разных доменах (тогда нужен CORS).
VITE_API_URL=/api

# Куда Vite проксирует /api при npm run dev
DEV_API_PROXY=http://localhost:3000

# Sentry для фронтенда (DSN отдельного проекта типа React)
VITE_SENTRY_DSN=
VITE_APP_RELEASE=dev

# Загрузка source maps в Sentry при сборке (только в CI, токен — секрет)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
