@baseUrl = http://localhost:3000/api

### Логин user
# @name loginUser
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "user@example.com", "password": "Password123!" }

### Логин admin
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "admin@example.com", "password": "Password123!" }

### Текущий пользователь
GET {{baseUrl}}/auth/me
Authorization: Bearer {{loginUser.response.body.data.accessToken}}

### Список материалов с фильтром и поиском
GET {{baseUrl}}/materials?type=book&search=javascript

### Статистика
GET {{baseUrl}}/materials/stats

### Создать материал (user)
# @name createMaterial
POST {{baseUrl}}/materials
Authorization: Bearer {{loginUser.response.body.data.accessToken}}
Content-Type: application/json

{
  "title": "Лекция 2. Express.js",
  "type": "lecture",
  "subject": "Интернет-технологии",
  "author": "Петров П.П.",
  "fileUrl": "https://example.com/files/lecture-2-express.pdf",
  "tags": ["express"]
}

### Удалить материал (admin)
DELETE {{baseUrl}}/materials/{{createMaterial.response.body.data.id}}
Authorization: Bearer {{loginAdmin.response.body.data.accessToken}}
