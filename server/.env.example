PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://study:study@localhost:5432/study_materials

# Длинная случайная строка: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Время жизни access-токена
JWT_EXPIRES_IN=15m
# Время жизни refresh-токена (httpOnly cookie), в днях
REFRESH_TOKEN_TTL_DAYS=7

# Домены фронтенда, которым разрешён доступ к API (через запятую)
CORS_ORIGINS=http://localhost:5173

# Запросов с одного IP за 15 минут: всего и к /auth/login, /auth/register
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Число прокси перед приложением (Render — 1, Vercel → Render — 2, nginx/Caddy на VM — 2).
# Нужно, чтобы req.ip и rate limit видели IP клиента. Локально не задаётся.
TRUST_PROXY=
# TLS-подключение к облачной БД (Neon, Supabase)
DATABASE_SSL=false
# Уровень логов: error | warn | info | http (http — ещё и каждый успешный запрос)
LOG_LEVEL=info

# ---- Мониторинг (каждый сервис включается, только если задан его ключ) ----
# Sentry: Project Settings → Client Keys (DSN)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Better Stack Logs: Sources → Node.js → Source token и Ingesting host
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=
# Telegram: токен от @BotFather и chat_id (например, через @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
