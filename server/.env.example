PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://study:study@localhost:5432/study_materials

# Длинная случайная строка: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Время жизни access-токена
JWT_EXPIRES_IN=15m
# Время жизни refresh-токена (httpOnly cookie), в днях
REFRESH_TOKEN_TTL_DAYS=7

# Домены фронтенда, которым разрешён доступ к API (через запятую)
CORS_ORIGINS=http://localhost:5173

# Запросов с одного IP за 15 минут: всего и к /auth/login, /auth/register
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
